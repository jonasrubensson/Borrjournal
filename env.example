# Kopiera till .env och fyll i. Generera hemligheter med: openssl rand -base64 36
POSTGRES_PASSWORD=
SECRET_KEY=
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=

# Valfritt
TOKEN_EXPIRE_HOURS=12
MAX_UPLOAD_MB=25
SEED_DEMO=false
# Var appen ska lyssna. 127.0.0.1 om NPM kör på samma värd utan delat
# Docker-nätverk. Använder du nätverket "proxy" behövs ingen portpublicering alls.
APP_BIND=127.0.0.1:8000
