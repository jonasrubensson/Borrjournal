# Kopiera till .env. Två rader måste fyllas i, resten kan stå som det är.
#
# Generera med:  openssl rand -hex 32
SECRET_KEY=

# Ditt första inloggningslösenord. Byt konto direkt efter första inloggningen.
BOOTSTRAP_PASSWORD=

BOOTSTRAP_ADMIN=admin

# Sätt till true innan första starten om du vill ha demodata att klicka runt i.
SEED_DEMO=false

# Port och lyssnaradress.
#
# 0.0.0.0 fungerar alltid, även när nginx kör i en egen container. Nackdelen är
# att appen då går att nå direkt på port 8000, förbi proxyn och därmed förbi
# klientcertifikaten. Stäng porten i brandväggen, eller läs avsnittet Säkerhet
# i README om hur du kör helt utan publicerad port.
#
# Kör nginx direkt på värden räcker APP_BIND=127.0.0.1.
APP_PORT=8000
APP_BIND=0.0.0.0

# Säkerhetsheaders. Lämna på. SECURITY_HEADERS=false stänger av allt och är
# bara till för felsökning.
SECURITY_HEADERS=true

# Sätt true om en tjänst som Cloudflare ligger framför och visar robotkontroll.
# Utan detta blockeras deras skript och ruta av policyn, och besökaren fastnar
# i "Utför säkerhetsverifiering".
ALLOW_CHALLENGE_SCRIPTS=false

# Ytterligare källor att tillåta, mellanslagsseparerat. För andra tjänster än
# Cloudflare, till exempel CSP_EXTRA_SOURCES=https://challenges.example.com
CSP_EXTRA_SOURCES=

# Adressuppslag mot OpenStreetMap. Deras villkor kräver en User-Agent som
# identifierar er, gärna med kontaktadress, annars kan uppslagen avvisas.
GEOCODER_USER_AGENT=Borrjournal (namn@dinfirma.se)

TOKEN_EXPIRE_HOURS=12
MAX_UPLOAD_MB=25
