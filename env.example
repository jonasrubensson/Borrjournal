# Kopiera till .env och fyll i.
#
# Generera hemligheter med hex, inte base64:
#     openssl rand -hex 24
# Base64 ger tecken som / och + som ställer till det i anslutningssträngar och
# skalkommandon. Hex ger bara 0-9 och a-f, lika säkert och aldrig krångel.
#
# VIKTIGT: POSTGRES_PASSWORD läses bara första gången databasen skapas. Ändrar du
# det efteråt måste du också ändra det i databasen, eller radera volymen db-data.
POSTGRES_PASSWORD=
SECRET_KEY=
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=

# Valfritt
TOKEN_EXPIRE_HOURS=12
MAX_UPLOAD_MB=25
SEED_DEMO=false
# Porten appen publiceras på. Ändra om 8000 redan är upptagen.
APP_PORT=8000

# Vilken adress porten binds till. 0.0.0.0 = alla gränssnitt, vilket krävs om
# din reverse proxy kör i Docker. Sätt 127.0.0.1 om proxyn kör direkt på värden.
APP_BIND=0.0.0.0
