# Kopiera till .env. Två rader måste fyllas i, resten kan stå som det är.
#
# Generera med:  openssl rand -hex 32
SECRET_KEY=

# Ditt första inloggningslösenord. Byt konto direkt efter första inloggningen.
BOOTSTRAP_PASSWORD=

BOOTSTRAP_ADMIN=admin

# Sätt till true innan första starten om du vill ha demodata att klicka runt i.
SEED_DEMO=false

# Port och lyssnaradress.
# 127.0.0.1 betyder att bara värden når appen, alltså nginx. Sätt aldrig
# 0.0.0.0 när appen ska skyddas av en proxy med mTLS: då går den att nå direkt
# från nätverket, och både klientcertifikat och inloggning kringgås.
APP_PORT=8000
APP_BIND=127.0.0.1

# Adressuppslag mot OpenStreetMap. Deras villkor kräver en User-Agent som
# identifierar er, gärna med kontaktadress, annars kan uppslagen avvisas.
GEOCODER_USER_AGENT=Borrjournal (namn@dinfirma.se)

TOKEN_EXPIRE_HOURS=12
MAX_UPLOAD_MB=25
