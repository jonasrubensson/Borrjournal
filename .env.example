# Kopiera till .env. Två rader måste fyllas i, resten kan stå som det är.
#
# Generera med:  openssl rand -hex 32
SECRET_KEY=

# Ditt första inloggningslösenord. Byt konto direkt efter första inloggningen.
BOOTSTRAP_PASSWORD=

BOOTSTRAP_ADMIN=admin

# Sätt till true innan första starten om du vill ha demodata att klicka runt i.
SEED_DEMO=false

# ---- Vilka images som körs ----
# Lämnas de tomma byggs imagerna lokalt, vilket fungerar utan register.
#
# Vill du i stället hämta färdiga images, ta bort brädgården nedan och byt
# ditt-konto mot ditt GitHub-konto. Adressen MÅSTE vara helt med små bokstäver,
# även om kontonamnet har versaler. Docker vägrar annars starta.
# Då räcker "docker compose pull && docker compose up -d" för att uppdatera.
#BORRJOURNAL_IMAGE=ghcr.io/ditt-konto/borrjournal:latest
#SIGNERING_IMAGE=ghcr.io/ditt-konto/borrjournal-signering:latest

# Port och lyssnaradress.
#
# 0.0.0.0 fungerar alltid, även när nginx kör i en egen container. Nackdelen är
# att appen då går att nå direkt på port 8000, förbi proxyn och därmed förbi
# klientcertifikaten. Stäng porten i brandväggen, eller läs avsnittet Säkerhet
# i README om hur du kör helt utan publicerad port.
#
# Kör nginx direkt på värden räcker APP_BIND=127.0.0.1.
APP_PORT=8000
APP_BIND=0.0.0.0

# Säkerhetsheaders. Lämna på. SECURITY_HEADERS=false stänger av allt och är
# bara till för felsökning.
SECURITY_HEADERS=true

# Sätt true om en tjänst som Cloudflare ligger framför och visar robotkontroll.
# Utan detta blockeras deras skript och ruta av policyn, och besökaren fastnar
# i "Utför säkerhetsverifiering".
ALLOW_CHALLENGE_SCRIPTS=false

# Ytterligare källor att tillåta, mellanslagsseparerat. För andra tjänster än
# Cloudflare, till exempel CSP_EXTRA_SOURCES=https://challenges.example.com
CSP_EXTRA_SOURCES=

# ---- Signering av offerter ----
# Fristående tjänst som kunder når publikt. Borrjournal öppnar aldrig någon väg
# inåt, den frågar bara tjänsten om något hänt. Töm SIGNERING_URL för att
# stänga av funktionen.
#
# Nyckeln måste vara minst 24 tecken och samma på båda sidor:
#   openssl rand -hex 32
SIGNERING_NYCKEL=
# Så här når Borrjournal tjänsten, internt i dockernätverket
SIGNERING_URL=http://signering:8000
# Så här når kunden den, alltså din publika adress
SIGNERING_URL_PUBLIK=https://signera.dinfirma.se
SIGNERING_PORT=8010
SIGNERING_BIND=0.0.0.0
# Frivillig tidsstämplingstjänst (RFC 3161) som stärker beviset
TSA_URL=

# ---- E-post ----
# Appen skickar bara utgående post, den tar aldrig emot. En relätjänst är
# därför enklare än en vanlig brevlåda.
#
#   SMTP2GO   mail.smtp2go.com      587   SMTP-användare från panelen
#   Brevo     smtp-relay.brevo.com  587   lösenordet är SMTP-nyckeln
#   Mailgun   smtp.eu.mailgun.org   587   EU-servern om kontot är i EU
#   Postmark  smtp.postmarkapp.com  587   API-token som både namn och lösenord
#   Gmail     smtp.gmail.com        587   app-lösenord vid tvåstegsverifiering
#
# Verifiera avsändardomänen (SPF och DKIM) hos leverantören, annars hamnar
# offerter och signeringslänkar i kundens skräppost.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_SECURITY=starttls

# Adressuppslag mot OpenStreetMap. Deras villkor kräver en User-Agent som
# identifierar er, gärna med kontaktadress, annars kan uppslagen avvisas.
GEOCODER_USER_AGENT=Borrjournal (namn@dinfirma.se)

TOKEN_EXPIRE_HOURS=12
MAX_UPLOAD_MB=25
